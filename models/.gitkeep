# Model files live here but are intentionally NOT committed to git.
#
# Download them with:
#   python scripts/download_models.py
#
# This fetches the CPU variant of onnx-community/Qwen3-0.6B-ONNX and writes:
#   - genai_config.json
#   - config.json
#   - tokenizer.json
#   - tokenizer_config.json
#   - chat_template.jinja
#   - model.onnx
#
# Set EVENT_MODEL_PATH env var to point to a different directory if needed.
